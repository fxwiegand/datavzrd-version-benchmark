configfile: "config/config.yaml"


SHAPES = [tuple(shape) for shape in config["shapes"]]

VERSIONS = config["versions"]
LATEST = VERSIONS[-1]


def render_memory(wildcards):
    cells = int(wildcards.rows) * int(wildcards.cols) * int(wildcards.tables)
    return 1000 + int(cells * 0.0005)


rule all:
    input:
        "results/report",
        "results/comparison.csv",


rule generate:
    output:
        data=temp(directory("results/data/{rows}_{cols}_{tables}")),
        spec="results/configs/{rows}_{cols}_{tables}.yaml",
    params:
        seed=config["seed"],
    conda:
        "envs/pandas.yaml"
    script:
        "scripts/generate.py"


rule render:
    input:
        spec="results/configs/{rows}_{cols}_{tables}.yaml",
        data="results/data/{rows}_{cols}_{tables}",
    output:
        "results/metrics/{version}/{rows}_{cols}_{tables}.tsv",
    params:
        repeats=config["repeats"],
    resources:
        mem_mb=render_memory,
    conda:
        "envs/datavzrd-{version}.yaml"
    script:
        "scripts/measure.py"


rule aggregate:
    input:
        metrics=[
            f"results/metrics/{version}/{rows}_{cols}_{tables}.tsv"
            for version in VERSIONS
            for rows, cols, tables in SHAPES
        ],
    output:
        table="results/comparison.csv",
        spec="results/comparison.yaml",
    params:
        versions=VERSIONS,
        shapes=SHAPES,
    conda:
        "envs/pandas.yaml"
    script:
        "scripts/aggregate.py"


rule report:
    input:
        spec="results/comparison.yaml",
        table="results/comparison.csv",
    output:
        report(
            directory("results/report"),
            htmlindex="index.html",
            category="datavzrd benchmark",
        ),
    conda:
        f"envs/datavzrd-{LATEST}.yaml"
    shell:
        "datavzrd {input.spec} --output {output} --overwrite-output"
