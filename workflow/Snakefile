configfile: "config/config.yaml"


SHAPES = []
for rows in config["sizes"]:
    SHAPES.append((rows, config["base_width"]))
for width in config["widths"]:
    shape = (config["base_rows"], width)
    if shape not in SHAPES:
        SHAPES.append(shape)

SHAPE_ROWS = [rows for rows, cols in SHAPES]
SHAPE_COLS = [cols for rows, cols in SHAPES]


def render_memory(wildcards):
    return 1000 + int(int(wildcards.rows) * int(wildcards.cols) * 0.0005)


rule all:
    input:
        "results/report",
        "results/comparison.csv",


rule generate:
    output:
        table=temp("results/data/{rows}_{cols}.csv"),
        spec="results/configs/{rows}_{cols}.yaml",
    params:
        seed=config["seed"],
    conda:
        "envs/pandas.yaml"
    script:
        "scripts/generate.py"


rule render_old:
    input:
        spec="results/configs/{rows}_{cols}.yaml",
        table="results/data/{rows}_{cols}.csv",
    output:
        "results/metrics/old/{rows}_{cols}.tsv",
    params:
        repeats=config["repeats"],
    resources:
        mem_mb=render_memory,
    conda:
        "envs/datavzrd-2.72.0.yaml"
    script:
        "scripts/measure.py"


rule render_new:
    input:
        spec="results/configs/{rows}_{cols}.yaml",
        table="results/data/{rows}_{cols}.csv",
    output:
        "results/metrics/new/{rows}_{cols}.tsv",
    params:
        repeats=config["repeats"],
    resources:
        mem_mb=render_memory,
    conda:
        "envs/datavzrd-2.72.1.yaml"
    script:
        "scripts/measure.py"


rule aggregate:
    input:
        old=expand("results/metrics/old/{rows}_{cols}.tsv", zip, rows=SHAPE_ROWS, cols=SHAPE_COLS),
        new=expand("results/metrics/new/{rows}_{cols}.tsv", zip, rows=SHAPE_ROWS, cols=SHAPE_COLS),
    output:
        table="results/comparison.csv",
        spec="results/comparison.yaml",
    params:
        shapes=SHAPES,
        old_version=config["versions"]["old"],
        new_version=config["versions"]["new"],
    conda:
        "envs/pandas.yaml"
    script:
        "scripts/aggregate.py"


rule report:
    input:
        spec="results/comparison.yaml",
        table="results/comparison.csv",
    output:
        report(
            directory("results/report"),
            htmlindex="index.html",
            category="datavzrd benchmark",
        ),
    conda:
        "envs/datavzrd-2.72.1.yaml"
    shell:
        "datavzrd {input.spec} --output {output} --overwrite-output"
