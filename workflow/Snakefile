configfile: "config/config.yaml"


SHAPES = [(rows, cols) for rows in config["rows"] for cols in config["columns"]]

VERSIONS = config["versions"]
LATEST = VERSIONS[-1]


def render_memory(wildcards):
    return 1000 + int(int(wildcards.rows) * int(wildcards.cols) * 0.0005)


rule all:
    input:
        "results/report",
        "results/comparison.csv",


rule generate:
    output:
        table=temp("results/data/{rows}_{cols}.csv"),
        spec="results/configs/{rows}_{cols}.yaml",
    params:
        seed=config["seed"],
    conda:
        "envs/pandas.yaml"
    script:
        "scripts/generate.py"


rule render:
    input:
        spec="results/configs/{rows}_{cols}.yaml",
        table="results/data/{rows}_{cols}.csv",
    output:
        "results/metrics/{version}/{rows}_{cols}.tsv",
    params:
        repeats=config["repeats"],
    resources:
        mem_mb=render_memory,
    conda:
        "envs/datavzrd-{version}.yaml"
    script:
        "scripts/measure.py"


rule aggregate:
    input:
        metrics=[
            f"results/metrics/{version}/{rows}_{cols}.tsv"
            for version in VERSIONS
            for rows, cols in SHAPES
        ],
    output:
        table="results/comparison.csv",
        spec="results/comparison.yaml",
    params:
        versions=VERSIONS,
        shapes=SHAPES,
    conda:
        "envs/pandas.yaml"
    script:
        "scripts/aggregate.py"


rule report:
    input:
        spec="results/comparison.yaml",
        table="results/comparison.csv",
    output:
        report(
            directory("results/report"),
            htmlindex="index.html",
            category="datavzrd benchmark",
        ),
    conda:
        f"envs/datavzrd-{LATEST}.yaml"
    shell:
        "datavzrd {input.spec} --output {output} --overwrite-output"
